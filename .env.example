NEXT_PUBLIC_SITE_URL=https://delyroses-ec.com
NEXT_PUBLIC_CURRENCY=USD
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_IMAGE_CDN_URL=https://cdn.delyroses-ec.com
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_GOOGLE_CUSTOMER_REVIEWS_MERCHANT_ID=00000000

# Server-side secret used to create the private Merchant Center feed URL.
# Use a long random value and share the final feed URL only inside Merchant Center.
MERCHANT_CENTER_FEED_TOKEN=
# Optional. Keep false/default so Merchant Center and manual browser tests can fetch the tokenized feed URL.
MERCHANT_CENTER_ENFORCE_GOOGLE_USER_AGENT=false

ORDER_ALLOWED_ORIGINS=https://delyroses-ec.com,https://www.delyroses-ec.com

# Supabase server-side checkout writes.
# Keep SUPABASE_SERVICE_ROLE_KEY only on the server. Never expose it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
